# Environment Variables
# Copy this file to .env.local and fill in your keys

# OpenRouter API Key (required for LLM-powered intent parsing & coupon targeting)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Razorpay Test Mode Keys (optional — leave empty for built-in sandbox mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
